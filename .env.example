# Local development. Copy to .env and adjust.
# MongoDB running in the local Docker container (port published on the host).
# With authentication: mongodb://<user>:<password>@localhost:27017/?authSource=admin
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=bank-tracking-dev

# API port in dev (Vite proxies /api to it). In prod the single container listens on PORT.
PORT=3001

# Session lifetime in days.
SESSION_TTL_DAYS=30

# Set to true only when the app is reached over HTTPS (secure cookie, HSTS).
HTTPS=false
