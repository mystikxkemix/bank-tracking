# Production settings. Copy to .env next to docker-compose.yml.

# The Mongo container runs on the same machine and publishes 27017 on the host.
# Use a database name different from the dev one.
MONGODB_URI=mongodb://<user>:<password>@host.docker.internal:27017/?authSource=admin
MONGODB_DB=bank-tracking

# Port of the machine where the app is exposed.
HOST_PORT=8080

# true only if users reach the app through an HTTPS reverse proxy.
HTTPS=false

SESSION_TTL_DAYS=30
